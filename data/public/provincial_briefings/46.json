otal_records":0,"items":[]},"housing":{"source_id":"f3_housing_portal","title_th":"ที่อยู่อาศัยและความเสี่ยงเมือง","status":"source_has_no_record_for_province","total_records":0,"items":[],"resource_groups":[]},"culture":{"source_id":"f2_culturalmap_university","title_th":"ทุนวัฒนธรรมในพื้นที่","status":"available","total_records":5,"items":[{"record_id":"CD-2988","record_code":"PA-46180-00001","title_th":"ศิลปินภูไท","title_en":null,"category":"ศิลปะการแสดง","cultural_type":"จับต้องไม่ได้","risk_status_code":3,"risk_reason":"การผันแปรค่อนข้างปานกลาง ขึ้นอยู่กับระบบเศรฐกิจ","history":"คณะหมอลำศิลปินภูไทนั้น แต่เดิมเป็นคณะหมอลำในชื่อคณะ วีระพงษ์ วงศ์ศิลป์ ซึ่งผู้ก่อตั้งคณะหมอลำคือ คุณพ่อสิทธิพงษ์ โทไข่ษร ศิลปินหมอลำที่เดินสายสังกัดคณะต่างๆ หลายคณะจนมีชื่อสียง จนเมื่อปี พ.ศ. 2557 คุณพ่อ คุณพ่อสิทธิพงษ์ โทไข่ษร หรือหมอลำวีรพงษ์ วงศิลป์ ได้ก่อตั้งเป็นวงของตัวเองโดยใช้ชื่อว่า ศิลปินภูไท มีชื่อเสียง เป็นที่ครองใจมหาชนในรูปแบบหมอลำเรื่องต่อกลอนทำนองกาฬสินธุ์","potential":null,"stakeholders":"ศูนย์วัฒนธรรมมหาวิทยาลัยขอนแก่น","amphoe":"คำม่วง","tambon":"ทุ่งคลอง","coordinates":{"latitude":16.91068,"longitude":103.63094},"recorded_at":"2022-07-08","image_url":"https://dp.culturalmapthailand.info/file-upload/00300/2988/A13F650029-0012-001.jpg","source_url":"https://www.culturalmapthailand.info/CD-2988","validation_warnings":[]},{"record_id":"CD-3004","record_code":"PA-46110-00001","title_th":"อ้น แคนเขียว เอนเตอร์เทนเมน","title_en":null,"category":"ศิลปะการแสดง","cultural_type":"จับต้องไม่ได้","risk_status_code":4,"risk_reason":"ซอฟต์แวร์ค้นหาเพลงของบริษัทที่มีธุรกิจการจัดการดนตรีจะเสนอตัวเลือกเป็นเพลงสำเร็จรูปให้กับลูกค้าเลือก","history":"พงศพร อุปนิ หรือหลายคนรู้จักในนาม “อ้น แคนเขียว” หมอแคนแห่งแดนอีสาน เกิดเมื่อวันที่ 25 พฤศจิกายน 2534 ที่อยู่ 109/1 บ้านหนองโจด ตำบลบัวขาว อำเภอกุฉินารายณ์ จังหวัดกาฬสินธุ์ รหัสไปรษณีย์ 46110 เป็นผู้มีผลงานชนะเลิศการแข่งขันโปงลางชิงถ้วยพระราชทานสมเด็จพระนางเจ้าสิริกิติ์ พระบรมราชินีนาถ ปี 2553, แชมป์หมอแคนอันดับ 1 ของประเทศไทย ปี 2554, เป็นหมอแคนให้กับศิลปินแห่งชาติ (หมอลำเคน ดาเหลาและหมอลำฉวีวรรณ ดำเนิน), มีอัลบั้มเดี่ยวแคน ชุดตามฮอยผู้เฒ่า, เรียบเรียงดนตรีอัลบั้มเคนฮุดชุดเต้ย, ทำดนตรีประกอบภาพยนตร์เรื่องผู้บ่าวไทบ้านอีสานอินดี้ และสร้างสรรค์ลายแคนควายน้อยคอยแม่ ซึ่งเป็นลายแคนที่สร้างแรงบันดาลใจให้กับนักศึกษาได้ศึกษา วิเคราะห์เทคนิควิธีการในการสร้างสรรค์ดนตรีพื้นเมืองได้ ปัจจุบันรับเรียบเรียงดนตรีเพลงลูกทุ่งหมอลำและลายดนตรีพื้นบ้านอีสาน ในนามค่ายเพลงอ้นแคนเขียวเอนเตอร์เทนเม้นท์","potential":null,"stakeholders":null,"amphoe":"กุฉินารายณ์","tambon":"บัวขาว","coordinates":{"latitude":16.56146,"longitude":104.0574},"recorded_at":"2022-07-05","image_url":"https://dp.culturalmapthailand.info/file-upload/00300/3004/A13F650029-0027-001.jpg","source_url":"https://www.culturalmapthailand.info/CD-3004","validation_warnings":[]},{"record_id":"CD-3015","record_code":"PA-46110-00002","title_th":"ภูไท สตูดิโอ","title_en":null,"category":"ศิลปะการแสดง","cultural_type":"จับต้องไม่ได้","risk_status_code":4,"risk_reason":"ลิขสิทธิ์ขณะไลฟ์สด","history":"การแพร่ระบาดของโควิด-19 เข้ามาแบบไม่ทันตั้งตัว ทำให้เกิดผลกระทบต่อการแสดงของหมอลำเป็นอย่างมาก อันเนื่องจากมาตรการของรัฐและการไม่กล้าจัดกิจกรรมของเจ้าภาพ จึงเป็นอีกจุดเปลี่ยนสำคัญใน\r\nประวัติศาสตร์ของหมอลำ คือ หมอลำก้าวสู่พื้นที่ออนไลน์อย่างเต็มรูปแบบ ภายใต้การดิ้นรนเพื่อ\r\nความอยู่รอดและเพื่อปากท้องของคนหลายร้อยชีวิตในแต่ละวง ไลฟ์สดสตรีมมิ่งครบวงจร จึงเป็นทางเลือกใหม่ในการจัดงานในยุคโควิด-19 ที่ผู้ชมไม่ต้องมาชมสถานที่จริง เพื่อซื้อบัตรเข้าชมแบบออนไลน์ก็สามารถสนุกร่วมไปกับวงหมอลำได้ง่าย ๆ ที่บ้านของตนเอง ภูไทสตูดิโอ เป็นกลุ่มไลฟ์สตรีมมิ่งคุณภาพอีกกลุ่มหนึ่ง มองเห็นช่องทางทำเงินในยุคโควิด-19 จึงเกิดธุรกิจไลฟ์สดสตรีมมิ่งไว้คอยบริการให้กับวงหมอลำทั่วภาคอีสาน ด้วยคุณภาพงานที่ดี ภาพสวย มุมกล้องดี เสียงชัด จึงได้รับความนิยมในวงการหมอลำและการแสดงดนตรีอื่น ๆ ราคาเริ่มต้นที่ 5,000 – 35,000 บาท นอกจากนี้การไลฟ์สดยังสามารถนำไปลงช่องยูทูปเพื่อการเปิดดูย้อนหลังได้ด้วย อีกทั้งยอดวิวสามารถสร้างรายได้ให้กับกลุ่มไลฟ์สดได้อีกหนึ่งช่องทาง อีกทั้งยังมีบริการถ่ายภาพนิ่ง และภาพวิดีโออีกด้วย","potential":null,"stakeholders":"--","amphoe":"กุฉินารายณ์","tambon":"กุดหว้า","coordinates":{"latitude":16.51847,"longitude":104.1165},"recorded_at":"2022-07-12","image_url":"https://dp.culturalmapthailand.info/file-upload/00300/3015/A13F650029-0038-001.jpg","source_url":"https://www.culturalmapthailand.info/CD-3015","validation_warnings":[]},{"record_id":"CD-3315","record_code":"PA-46120-00001","title_th":"หมาเก้าหาง ดนตรีอีศาน คลาสสิก","title_en":null,"category":"ศิลปะการแสดง","cultural_type":"จับต้องได้","risk_status_code":3,"risk_reason":"กระแสนิยมเพลงต่างชาติเข้ามามีบทบาทต่อเยาวชนคนรุ่นใหม่ภายในประเทศเป็นอย่างมาก","history":"หมาเก้าหาง ดนตรีอีสานคลาสสิค บริหารวงโดยนายปรัชญา นันธะชัย เกิดเมื่อวันที่ 13 เมษายน 2538 ภูมิลำเนาเดิม 28/6 บ้านดงสาร ตำบลซาง อำเภอเซกา จังหวัดหนองคาย ปัจจุบันขึ้นเป็นจังหวัดบึงกาฬ และในปัจจุบันได้ย้ายถิ่นฐานมาอยู่บ้านเลขที่ 339 หมู่ 3 บ้านค้อ ตำบลยางตลาด อำเภอยางตลาด จังหวัดกาฬสินธุ์ เริ่มเรียนดนตรีพื้นบ้านเมื่อศึกษาชั้นประถมศึกษาปีที่ 3 เครื่องดนตรีชิ้นแรกที่สนใจและเรียนรู้อย่างจริงจัง คือ แคน เป็นศิษย์ของอาจารย์ทองคำ ไทยกล้า (เสียชีวิตแล้ว) ซึ่งเป็นปราชญ์พื้นบ้านและถือได้ว่าเป็นบรมครูด้านการเป่าแคน นายปรัชญา นันธะชัย ได้ศึกษาระดับปริญญาตรีที่วิทยาลัยนาฏศิลปเชียงใหม่ มีเพื่อนร่วมอุดมการณ์ในดานดนตรี ซึ่งได้ทำวงดนตรีที่นำเพลงเก่ามาเรียบเรียงใหม่ โดยใช้เครื่องดนตรีพื้นบ้านผสมผสานกับเครื่องดนตรีตะวันตก และตั้งชื่อวงว่า “ลมหลวง” เดินสายรับงานแสดงดนตรีในสถานประกอบการด้านความบันเทิง, สถาบันการศึกษาต่าง ๆ และจัดแสดงคอนเสิร์ต ชุด ซัน นันธะชัย โดยใช้ระยะเวลาในการแสดง 6 ชั่วโมง ต่อมาเมื่อปี พ.ศ.2560 นายปรัชญา นันธะชัย ได้ฝึกสอนที่วิทยาลัยนาฏศิลปกาฬสินธุ์ เกิดแนวคิดเกี่ยวกับวงดนตรีอีสานร่วมสมัย รับสมัครสมาชิกวงเป็นนักศึกษาเอกดนตรีชั้นปีที่ 2-3 รวมตัวกันฝึกซ้อมหลังเลิกเรียนและวันหยุด และได้ตั้งชื่อวง “หมาเก้าหาง” ต้นกำเนิดของวงดนตรีอีสานคลาสสิค รับงานการแสดงเรื่อยมาจนถึงปัจจุบัน และรับประพันธ์คำร้อง ประพันธ์ทำนองให้กับวงโปงลาง ตลอดจนวงหมอลำมากมายหลายคณะ","potential":null,"stakeholders":null,"amphoe":"ยางตลาด","tambon":"ยางตลาด","coordinates":{"latitude":16.37765,"longitude":103.34879},"recorded_at":"2022-12-28","image_url":"https://dp.culturalmapthailand.info/file-upload/00300/3315/A13F650029-0059-001.jpg","source_url":"https://www.culturalmapthailand.info/CD-3315","validation_warnings":[]},{"record_id":"CD-3349","record_code":"PA-46180-00002","title_th":"ร้านจุก แพรวา บ้านโพน","title_en":null,"category":"ศิลปะการแสดง","cultural_type":"จับต้องได้","risk_status_code":1,"risk_reason":"ตลาดมีความต้องการผลิตภัณฑ์อย่างสม่ำเสมอ","history":"นางบุญชู ไพรรัตน์ หรือจุกแพรวา เป็นผู้มีความสามารถในการทอผ้าพื้นบ้านบ้านหลายชนิด แต่มีชื่อเสียงโด่งดังเป็นที่เลื่องลือคือผ้าไหมแพรวา เป็นผ้าอัตลักษณ์ของชาวจังหวัดกาฬสินธุ์ มีความวิจิตรงดงาม ได้เริ่มฝึกหัดทอผ้าแพรวามาตั้งแต่ปี พ.ศ. 2525 แม่ได้สั่งสมประสบการณ์มาถึงปี พ.ศ. 2530 และได้ทำการค้าขายผ้าพื้นเมืองและผ้าแพรวา เป็นระยะเวลา 35 ปี ได้รับความนิยมจากผู้บริโภคมากมาย เป็นการกระตุ้นเศรษฐกิจให้กับช่างทอผ้าพื้นบ้าน กลุ่มศิลปินนักร้องในวงหมอลำชื่อดังในปัจจุบัน นิยมใช้ผ้าไหมแพรวาประดับตกแต่งเสื้อผ้าของหมอลำ ด้วยตัวของผ้าแพรวานั้นมีความวิจิตรงดงาม โดยเทคนิคและวิธีการทอนั้นยากลำบาก ผู้ทอผ้าแพรวาต้องอาศัยความอดทนเป็นอย่างยิ่ง ราคาเริ่มต้นที่ 300 - สามารถเยี่ยมชมและอุดหนุนผลิตภัณฑ์ได้ที่ 260 หมู่ 1 บ้านทุ่งคลอง ตำบลทุ่งคลอง อำเภอคำม่วง จังหวัดกาฬสินธุ์","potential":null,"stakeholders":null,"amphoe":"คำม่วง","tambon":"ทุ่งคลอง","coordinates":{"latitude":16.942111,"longitude":103.629897},"recorded_at":"2023-01-06","image_url":"https://dp.culturalmapthailand.info/file-upload/00300/3349/A13F650029-0084-001.jpg","source_url":"https://www.culturalmapthailand.info/CD-3349","validation_warnings":[]}]},"tourism":{"source_id":"f3_ruamthiao_lamphun","title_th":"การเดินทางและท่องเที่ยวลำพูน","status":"source_has_no_record_for_province","total_records":0,"items":[]},"pppconnext":{"source_id":"f1_pppconnext","title_th":"ครัวเรือนและทุนดำรงชีพ","status":"available","total_records":15,"items":[{"metric_name":"จำนวนครัวเรือน","value":13740.0,"unit":"households","widget":"households_by_province","source_url"