{
  "plan_version": "0.1.0",
  "notes_th": "Executable allowlist เท่านั้น; endpoint catalog ทั้งหมดอยู่ใน source_catalog.json. แหล่งที่ผู้ใช้ดูแล 10 เว็บ: 9 แหล่งสาธารณะมี connector (รวม f1_pppconnext, f2_target_household และกระเป๋าตังค์สองแหล่ง) ส่วน f2_rmutdb คง snapshot_only เพราะ live JSON 503, /ebook 404 และ PDF ใหญ่เกินที่จะ GET ตอน ingest. Restricted เหลือเฉพาะ Nonthaburi สองแหล่ง.",
  "sources": {
    "clig_projects": {
      "driver": "clig_projects",
      "connector": "app.connectors.clig_projects:CligProjectsConnector",
      "list_url": "https://clig.oas.psu.ac.th/api/project/search_project",
      "detail_url_template": "https://clig.oas.psu.ac.th/iframe/project/project_info?id={project_id}",
      "project_name": "",
      "project_year": "",
      "max_pages": 500,
      "expected_policy_candidate_count": 107,
      "completeness_gate": "project_id ต้องไม่ซ้ำ; pagination ต้องจบด้วย empty/no-data page หรือหน้าสุดท้ายที่แสดง",
      "explicit_exclusions": [
        "/login",
        "/admin",
        "write actions",
        "project PDF/file downloads until separately approved"
      ]
    },
    "f1_sradss_ppaos": {
      "driver": "sradss",
      "connector": "app.connectors.sradss:SradssConnector",
      "requests": [
        {
          "name": "summary_updated_at",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_summary_updated_at.php",
          "params": {
            "_nc": "1"
          }
        },
        {
          "name": "provinces",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_provinces.php",
          "params": {
            "year": "$SRA_YEAR"
          }
        },
        {
          "name": "poverty_map_core",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_poverty_map_core.php",
          "params": {
            "year": "$SRA_YEAR",
            "amp": "ALL",
            "prov": "ALL",
            "tambon": "ALL"
          }
        },
        {
          "name": "poverty_situation",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_poverty_situation.php",
          "params": {
            "year": "$SRA_YEAR",
            "amp": "ALL",
            "prov": "ALL",
            "tambon": "ALL"
          }
        },
        {
          "name": "provinces_summary",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_provinces_summary.php",
          "params": {
            "year": "$SRA_YEAR",
            "prov": "ALL"
          }
        },
        {
          "name": "continuous_poor",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_continuous_poor.php",
          "params": {
            "year": "$SRA_YEAR",
            "amp": "ALL",
            "prov": "ALL",
            "tambon": "ALL"
          }
        },
        {
          "name": "data_analysis",
          "url": "https://sradss.ppaos.com/dashboard/api/ppaos_data_analysis.php",
          "params": {
            "year": "$SRA_YEAR",
            "amp": "ALL",
            "prov": "ALL",
            "tambon": "ALL"
          }
        }
      ],
      "explicit_exclusions": [
        "data_household_detail.php",
        "data_household_map.php",
        "*_detail.php ที่เป็น person/household",
        "endpoint ที่ตอบ 401 หรือ login"
      ],
      "notes_th": "Serving ingest ดึงเฉพาะ aggregate ปีปัจจุบันแบบ amp/prov/tambon=ALL. การไล่ทะเบียนอำเภอ/ตำบลปี 2569 อยู่เลนหลักฐาน ไม่ใส่ household row เข้า dashboard_records"
    },
    "f1_pppconnext": {
      "driver": "pppconnext",
      "connector": "app.connectors.pppconnext:PppconnextConnector",
      "expected_record_count": 47,
      "completeness_gate": "commit only when the four catalog APIs project to 47 aggregate grains: 20 provinces plus national/year/capital/assistance summaries",
      "requests": [
        {
          "name": "national_bootstrap",
          "url": "https://ppaos.com/2026/api/khm/v1/dashboard/ppaos-national-bootstrap?metric=poor_households_rate&survey_year=all"
        },
        {
          "name": "province_analytics",
          "url": "https://ppaos.com/2026/api/khm/v1/dashboard/ppaos-province-analytics?prov_code=0&survey_year=all&chart_years=2563%2C2564%2C2565%2C2566%2C2567%2C2568%2C2569&chart_sections=cumulative"
        },
        {
          "name": "poor_capital_potential",
          "url": "https://ppaos.com/2026/api/khm/v1/dashboard/ppaos-poor-capital-potential?prov_code=0&survey_year=all"
        },
        {
          "name": "assistance_summary",
          "url": "https://ppaos.com/2026/api/khm/v1/dashboard/ppaos-assistance-summary?prov_code=0&survey_year=all"
        }
      ],
      "explicit_exclusions": [
        "/areas/provinces",
        "/areas/districts",
        "/areas/tambons",
        "/external/v1/areas/",
        "login POST",
        "per-province analytics outside the catalog prov_code=0 URL"
      ]
    },
    "f2_apptech_mtr": {
      "driver": "apptech_mtr",
      "connector": "app.connectors.apptech_mtr:ApptechMtrConnector",
      "url": "https://app.rinmp.com/api/appTechPublic",
      "query_params": {
        "__template": "appTech.public.list",
        "offset": "$OFFSET",
        "max": "$PAGE_SIZE"
      },
      "page_size": 99,
      "database_projection": "ลบ ownerContact, email, phone, address และ credential-shaped fields ก่อนเข้า database"
    },
    "f2_apptech_mru": {
      "driver": "apptech_mru",
      "connector": "app.connectors.apptech_mru:ApptechMruConnector",
      "page_size": 12,
      "completeness_gate": "commit only when unique record IDs equal totaldata for every dataset",
      "runtime_policy": "probe totaldata first; fetch full lists only on change; use validated snapshot after any incomplete/non-JSON/timeout response",
      "datasets": [
        {
          "name": "innovation",
          "url": "https://38rat.nstru.ac.th/backend/ajax/public/innovation.php",
          "json_body": {
            "action": "fetch_innovationAll_JSON",
            "filter": {
              "innovationgroup": "All",
              "affiliationid": "All",
              "innovationtype": "All",
              "orderby": 1,
              "cus_search1": "",
              "startlimit": "$OFFSET",
              "endlimit": "$PAGE_SIZE",
              "maxpage": 0,
              "targetpagenumber": "$PAGE_NUMBER"
            }
          }
        },
        {
          "name": "requirement",
          "url": "https://38rat.nstru.ac.th/backend/ajax/public/requirement.php",
          "json_body": {
            "action": "fetch_requirementAll_JSON",
            "filter": {
              "orderby": 1,
              "cus_search1": "",
              "startlimit": "$OFFSET",
              "endlimit": "$PAGE_SIZE",
              "maxpage": 0,
              "targetpagenumber": "$PAGE_NUMBER"
            }
          }
        },
        {
          "name": "news",
          "url": "https://38rat.nstru.ac.th/backend/ajax/public/news.php",
          "json_body": {
            "action": "fetch_newsAll_JSON",
            "filter": {
              "orderby": 1,
              "cus_search1": "",
              "startlimit": "$OFFSET",
              "endlimit": "$PAGE_SIZE",
              "maxpage": 0,
              "targetpagenumber": "$PAGE_NUMBER"
            }
          }
        }
      ],
      "explicit_exclusions": [
        "/backend/ajax/auth/*",
        "/backend/ajax/user/*",
        "write actions",
        "live HTML detail pages (province/funding/IP/TRL) — parse from reviewed evidence when the list API times out; never copy researcher names"
      ]
    },
    "f2_target_household": {
      "driver": "target_household",
      "connector": "app.connectors.target_household:TargetHouseholdConnector",
      "url": "https://pmua-apptech.com/search",
      "query_params": {
        "page": "$PAGE"
      },
      "dashboard_year_filters": [
        "all",
        "2025",
        "2026"
      ],
      "completeness_gate": "commit only when every advertised /search page is fetched, each page has product links, and product IDs are unique; do not freeze a prior listing count",
      "explicit_exclusions": [
        "/login",
        "/userlogin",
        "/dashboard/familydashboard as household-row extract",
        "/product/show/* live detail GET during serving ingest",
        "EPMS / POST login"
      ],
      "notes_th": "หน้าสาธารณะเป็นตลาดนวัตกรรม AppTech; serving เก็บรายการจาก /search และ aggregate dashboard ระดับจังหวัด/ประเทศเท่านั้น ตัดชื่อ เบอร์โทร อีเมล"
    },
    "f4_pmua_product_details": {
      "driver": "f4_pmua_product_details",
      "connector": "app.connectors.pmua_product_details:PmuaProductDetailsConnector",
      "list_url": "https://pmua-apptech.com/search",
      "detail_url_template": "https://pmua-apptech.com/product/show/{product_id}",
      "detail_retries": 3,
      "completeness_gate": "ดึงทุกหน้าตาม pagination และต้องได้ product detail ครบหนึ่งแถวต่อหนึ่ง product_id; หาก detail ใดล้มเหลวให้ล้มทั้งรันและไม่ commit",
      "explicit_exclusions": [
        "/login",
        "/userlogin",
        "/dashboard/familydashboard as household-row extract",
        "EPMS / POST login",
        "all non-numeric /product/show paths",
        "write actions"
      ],
      "notes_th": "เก็บเฉพาะหน้ารายละเอียดนวัตกรรมสาธารณะเพื่อ ROI/SROI ผลลัพธ์ ผลกระทบ และ TRL; ไม่เก็บข้อมูลติดต่อหรือข้อมูลบุคคล"
    },
    "f2_learning_dashboard": {
      "driver": "learning_dashboard",
      "connector": "app.connectors.learning_dashboard:LearningDashboardConnector",
      "url": "https://lesuper.app/api/opendata/pmua",
      "method": "POST",
      "body_mode": "json_empty",
      "expected_keys": [
        "provinces",
        "entityTypes",
        "categories",
        "geography",
        "geographyImpact",
        "impactSummary",
        "excludedResourceExpense"
      ],
      "scope_warning_th": "ข้อมูลครอบคลุมผู้เข้าร่วมโครงการที่ต้นทางเลือก ไม่ใช่ธุรกิจชุมชนทั้งหมด; ต้นทางไม่ระบุหน่วยหรือ as_of ระดับชุดข้อมูล"
    },
    "f2_learning_area_based": {
      "driver": "pmua_area_based",
      "connector": "app.connectors.pmua_area_based:PmuaAreaBasedConnector",
      "url": "https://lesuper.app/api/opendata/pmua/area-based",
      "completeness_gate": "unique non-null IDs and stats.totalRecords must equal data rows; every published stats dimension must reconcile before commit",
      "database_projection": "store 1,002 participant/business rows separately from source-published aggregate dimensions; never count aggregate rows as participants or projects"
    },
    "f2_wallet_all_realtime": {
      "driver": "wallet_all_realtime",
      "connector": "app.connectors.wallet_all_realtime:WalletAllRealtimeConnector",
      "expected_record_count": 2,
      "completeness_gate": "commit only when current-month POST {date:\"\"} returns both household and business envelopes with matching thisMonth",
      "requests": [
        {
          "name": "household_month",
          "method": "POST",
          "url": "https://lesuper.app/api/opendata/superapp/gen4/hh",
          "json_body": {"date": ""}
        },
        {
          "name": "business_month",
          "method": "POST",
          "url": "https://lesuper.app/api/opendata/superapp/gen4/bu",
          "json_body": {"date": ""}
        }
      ],
      "explicit_exclusions": [
        "GET /api/opendata/superapp/gen4/hh",
        "GET /api/opendata/superapp/gen4/bu",
        "historical monthly POST date=YYYY-MM-DD loops"
      ],
      "notes_th": "ดึงเดือนปัจจุบันตามที่หน้าข้อมูลเปิดเรียก; ประวัติรายเดือนเต็มอยู่เลนหลักฐาน/R2"
    },
    "f2_wallet_cluster_realtime": {
      "driver": "wallet_cluster_realtime",
      "connector": "app.connectors.wallet_cluster_realtime:WalletClusterRealtimeConnector",
      "expected_cluster_count": 7,
      "expected_record_count": 14,
      "completeness_gate": "commit only when household and business cluster inventories match and equal expected_cluster_count; do not fail on frontend hardcoded population totals",
      "requests": [
        {
          "name": "household_cluster",
          "method": "POST",
          "url": "https://lesuper.app/api/opendata/superapp/gen4/cluster/hh",
          "json_body": {}
        },
        {
          "name": "business_cluster",
          "method": "POST",
          "url": "https://lesuper.app/api/opendata/superapp/gen4/cluster/bu",
          "json_body": {}
        }
      ],
      "explicit_exclusions": [
        "GET cluster endpoints",
        "person-level or household-row extracts"
      ],
      "notes_th": "ดึงเดือนปัจจุบัน 7 กลุ่มธุรกิจตามที่หน้าข้อมูลเปิดแสดง; กลุ่มขนาดเล็กยังเป็น Candidate/needs_review"
    },
    "f3_housing_portal": {
      "driver": "housing_ckan",
      "connector": "app.connectors.housing_ckan:HousingCkanConnector",
      "package_show_url": "https://data.thaihousingportal.com/api/3/action/package_show",
      "expected_dataset_count": 7,
      "expected_resource_count": 41,
      "expected_value_resource_count": 39,
      "expected_value_record_count": 7259,
      "completeness_gate": "all seven packages and 41 unique resources must exist; all 39 value-approved CSV resources must parse to exactly 7,259 rows before commit",
      "privacy_gate": "the live connector keeps demand schema-only because its 25,919 respondent rows include birth year, income and other person-linked fields; policy-assessment values remain blocked. Any demand values in the serving database come from a separate pre-redacted reviewed artifact, not this live connector",
      "runtime_excluded_urls": [
        "https://data.thaihousingportal.com/dataset/67f58c26-0cde-410d-9ed2-c55ea2303c91/resource/ae090999-5a29-42c5-8518-40f5ece5b081/download/housing_demand_clean_stage_2.csv",
        "https://data.thaihousingportal.com/dataset/39edd2b9-01c8-4fca-a388-bae015de03ba/resource/3dcc96ea-6545-4ca1-88d5-58ad51ad2c18/download/policy_assessment_template.csv"
      ],
      "spatial_surfaces": {
        "database_strategy": "separate PostGIS schema or query-on-demand proxy; do not mix geometries into the 7,259 CKAN observation grain",
        "housing_points_endpoint": "https://data.thaihousingportal.com/api/bangkok-housing/subdistricts/{adm3_pcode}?category={category}",
        "housing_point_count_current": 28694,
        "subdistrict_boundary_endpoint": "https://data.thaihousingportal.com/api/bangkok-housing/subdistricts",
        "subdistrict_count_current": 169,
        "accessibility_grid_endpoint": "https://data.thaihousingportal.com/api/bangkok-housing/grid",
        "accessibility_grid_feature_count_current": 6543,
        "flood_grid_endpoint": "https://data.thaihousingportal.com/api/bangkok-housing/flood-risk?min_level=1",
        "flood_grid_feature_count_current": 159126,
        "radius_query_endpoint": "https://data.thaihousingportal.com/api/housing-stock/radius"
      },
      "datasets": [
        {
          "id": "demand",
          "value_policy": "schema_only"
        },
        {
          "id": "demandgap",
          "value_policy": "values"
        },
        {
          "id": "economic",
          "value_policy": "values"
        },
        {
          "id": "housingindex",
          "value_policy": "values"
        },
        {
          "id": "housingsupply",
          "value_policy": "values"
        },
        {
          "id": "policy-assessment",
          "value_policy": "blocked"
        },
        {
          "id": "population",
          "value_policy": "values"
        }
      ]
    },
    "spu_rawangphai_uru": {
      "driver": "spu_rawangphai_uru",
      "connector": "app.connectors.spu_rawangphai_uru:SpuRawangphaiUruConnector",
      "datasets": [
        {
          "name": "water_levels",
          "url": "https://rawangphai.uru.ac.th/api/water-level"
        },
        {
          "name": "rain_analysis",
          "url": "https://rawangphai.uru.ac.th/api/rain-analysis?active=true"
        },
        {
          "name": "shelters",
          "url": "https://rawangphai.uru.ac.th/api/shelters"
        }
      ]
    },
    "spu_sukhothai_water": {
      "driver": "spu_sukhothai_water",
      "connector": "app.connectors.spu_sukhothai_water:SpuSukhothaiWaterConnector",
      "datasets": [
        {
          "name": "water_levels",
          "url": "https://api-v3.thaiwater.net/api/v1/thaiwater30/public/waterlevel_load"
        },
        {
          "name": "rain_24h",
          "url": "https://api-v3.thaiwater.net/api/v1/thaiwater30/public/rain_24h"
        },
        {
          "name": "dams",
          "url": "https://api-v3.thaiwater.net/api/v1/thaiwater30/analyst/dam"
        }
      ]
    },
    "spu_sukhothai_care": {
      "driver": "spu_sukhothai_care",
      "connector": "app.connectors.spu_sukhothai_care:SpuSukhothaiCareConnector",
      "datasets": [
        {
          "name": "announcements",
          "url": "https://uat.sukhothaicare.in.th:3004/api/announcements",
          "paginate": true,
          "page_size": 100,
          "max_pages": 50
        },
        {
          "name": "incidents",
          "url": "https://uat.sukhothaicare.in.th:3004/api/incidents",
          "paginate": true,
          "page_size": 100,
          "max_pages": 50
        },
        {
          "name": "incident_map",
          "url": "https://uat.sukhothaicare.in.th:3004/api/incidents/map",
          "paginate": false
        },
        {
          "name": "incident_stats",
          "url": "https://uat.sukhothaicare.in.th:3004/api/incidents/stats",
          "paginate": false
        }
      ]
    },
    "spu_nsn_flood": {
      "driver": "spu_nsn_flood",
      "connector": "app.connectors.spu_nsn_flood:SpuNsnFloodConnector",
      "datasets": [
        {
          "name": "water_level_page",
          "url": "https://nsn-flood.nsru.ac.th/water-level"
        }
      ]
    }
  }
}
