{
  "as_of": {
    "fields": [
      "source_dates",
      "source_snapshots",
      "price_as_of"
    ],
    "note": "Capture/run timestamps are snapshot lineage, not price effective dates. Unknown price as_of remains explicit. No invented year or calendar-month filter.",
    "status": "source_snapshot_specific"
  },
  "builder": "tools.f2.__main__:main",
  "completeness": {
    "needs_review": false,
    "policy": "output_contracts",
    "review_items": []
  },
  "contract_id": "f2_dashboard",
  "contract_version": "1.0",
  "dataset_key": "f2_dashboard",
  "geography": {
    "fields": [
      "province_code",
      "scope_key"
    ],
    "level": "national_province_and_separate_source_regions",
    "note": "77 canonical provinces; unknown geography remains national; overlapping memberships are nonadditive."
  },
  "grain_th": "ผลตัวชี้วัดตามขอบเขตพื้นที่ และรายละเอียดหน่วยนับที่ผ่านการคัดเลือกฟิลด์",
  "identity": {
    "detail": [
      "entity_id"
    ],
    "result": [
      "measure_id",
      "scope_key"
    ]
  },
  "measures": [
    {
      "name": "K01A: จังหวัดที่มีหลักฐานกิจกรรมหรือความครอบคลุมโครงการ",
      "denominator": "COUNT DISTINCT province_code with qualifying programme coverage evidence",
      "unit": "province"
    },
    {
      "name": "K01B: พื้นที่วัฒนธรรมตามทะเบียนที่ใช้ในชุดส่งมอบ",
      "denominator": "COUNT DISTINCT cultural area: AtLocal programme areas and Cultural Map cultural spaces; an area found in both counts once",
      "unit": "area"
    },
    {
      "name": "K02: นวัตกรตามยอดรวมที่ PMUA รายงาน",
      "denominator": "SUM PMUA innovators_all province total_inno; reconcile to reported headline",
      "unit": "person"
    },
    {
      "name": "K03: กิจกรรมโครงการที่มีรายงาน",
      "denominator": "COUNT DISTINCT global_activity_id in accepted reported activities",
      "unit": "activity"
    },
    {
      "name": "K04: นวัตกรรมที่มีหลักฐานความพร้อมตามเกณฑ์",
      "denominator": "COUNT DISTINCT global_innovation_id with at least one eligible readiness assessment",
      "unit": "innovation"
    },
    {
      "name": "K05: ผู้ประกอบการและหน่วยธุรกิจวัฒนธรรมที่มีหลักฐานรองรับ",
      "denominator": "COUNT DISTINCT global_operator_id after source-contract cultural-business admission and accepted identity reconciliation",
      "unit": "operator"
    },
    {
      "name": "K06: ผู้ประกอบการวัฒนธรรม — ยังไม่คำนวณในชุดส่งมอบนี้",
      "denominator": "Not calculated in this release",
      "unit": "person"
    },
    {
      "name": "K07: ตระกูลสินค้า บริการ และผลงานที่มีหลักฐานรองรับ",
      "denominator": "COUNT DISTINCT family_id; ordinary variants within a supported maker context share one family; a broad range adds no extra parent count",
      "unit": "offering_family"
    },
    {
      "name": "K08: ธุรกิจชุมชนที่พัฒนาขีดความสามารถ — ยังไม่คำนวณในชุดส่งมอบนี้",
      "denominator": "Not calculated; accepted narrower score-linked business measure also deferred",
      "unit": "business"
    },
    {
      "name": "K09: การจ้างงานในพื้นที่ตามที่แหล่งข้อมูลรายงาน",
      "denominator": "SUM six regional localEmployeeAmount values",
      "unit": "person_per_month"
    },
    {
      "name": "K10: เงินที่รายงานว่าจ่ายแก่แรงงานและผู้จัดหาทรัพยากรในพื้นที่",
      "denominator": "(SUM localEmployeeExpense + SUM localResourceExpense) / 1000000",
      "unit": "million_THB_per_month"
    },
    {
      "name": "K11A: คลัสเทอร์อุตสาหกรรม — ไม่มีข้อมูลเพียงพอ",
      "denominator": "Unavailable; no supported cluster inventory",
      "unit": "cluster"
    },
    {
      "name": "K11B: จังหวัดที่มีคลัสเทอร์ — ไม่มีข้อมูลเพียงพอ",
      "denominator": "Unavailable; no supported cluster-province relationships",
      "unit": "province"
    },
    {
      "name": "K12: รายการทุนหรือเรื่องทางวัฒนธรรมในแผนที่หลังขจัดรายการซ้ำ",
      "denominator": "COUNT DISTINCT eligible Cultural Map map_inspiration subject_id",
      "unit": "mapped_subject"
    },
    {
      "name": "C02_COMMUNITY: บุคคลที่มีหลักฐานนวัตกรชุมชนในทะเบียน",
      "denominator": "COUNT DISTINCT global_person_id with a community_innovator or inventor contribution; province scope uses accepted source-reported innovator province memberships",
      "unit": "person"
    },
    {
      "name": "C04_LISTED: นวัตกรรมที่มีรายการทั้งหมด",
      "denominator": "COUNT DISTINCT global_innovation_id in broader listed inventory",
      "unit": "innovation"
    },
    {
      "name": "C08_PARTICIPATING: ธุรกิจหรือหน่วยธุรกิจที่มีหลักฐานเข้าร่วมโครงการ",
      "denominator": "COUNT DISTINCT contributing Learning area-based business_id",
      "unit": "participating_business_unit"
    },
    {
      "name": "C08_REPORTED_BUSINESSES: ธุรกิจตามยอดรวม Learning dashboard",
      "denominator": "SUM counts within each independent dimension; each reconciles to the reported total",
      "unit": "business"
    },
    {
      "name": "C08_ASSESSED_PEOPLE: บุคคลที่มีชุดคะแนนก่อนและหลังครบ",
      "denominator": "COUNT DISTINCT global person linked to a complete iCommunity assessment",
      "unit": "person"
    },
    {
      "name": "C08_INCREASED_PEOPLE: บุคคลที่รายงานคะแนนเพิ่มขึ้นอย่างน้อยหนึ่งด้าน",
      "denominator": "COUNT DISTINCT global person with at least one complete assessment having any dimension delta > 0",
      "unit": "person"
    },
    {
      "name": "C10_ALTERNATIVE: สูตรทางเลือกเพื่ออธิบายตัวเลขรายได้เดิม",
      "denominator": "(SUM localResourceExpense + SUM excludedResourceExpense) / 1000000",
      "unit": "million_THB_per_month"
    }
  ],
