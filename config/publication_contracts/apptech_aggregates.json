{
  "contract_version": "1.0",
  "contract_id": "apptech_aggregates",
  "dataset_key": "apptech_aggregates",
  "source_scope": "approved_values",
  "source_ids": ["f2_target_household"],
  "builder": "tools.build_apptech_aggregates:main",
  "grain_th": "ยอดนวัตกรชุมชนหนึ่งแถวต่อจังหวัดและตัวกรองปี; ยอดเงินหนึ่งแถวต่อประเทศและตัวกรองปี",
  "identity": {"province": ["year_filter", "province_name_th"], "country": ["year_filter"]},
  "geography": {"level": "province_and_country", "fields": ["province_name_th", "geography"]},
  "as_of": {"status": "not_provided_by_source", "fields": ["as_of"], "note": "generated_at คือเวลาบันทึกหลักฐาน ไม่ใช่วันที่อ้างอิงข้อมูล"},
  "measures": [
    {"name": "นวัตกรชุมชนและผู้ใช้ทั่วไปตามนิยามต้นทาง", "unit": "คน", "denominator": "ไม่ใช่อัตราส่วน; ไม่ได้แทนประชากรทั้งหมดของจังหวัด"},
    {"name": "ต้นทุนที่ลดลง รายได้ที่เพิ่มขึ้น และรายได้สุทธิที่เพิ่มขึ้น", "unit": "บาท", "denominator": "ยอดรวมประเทศตามตัวกรองปี; ไม่มีข้อมูลจัดสรรรายจังหวัดหรือภาค"}
  ],
  "completeness": {"policy": "output_contracts"},
  "privacy_profile": "aggregate_public",
  "outputs": [
    {
      "path": "data/public/apptech_aggregates.json",
      "format": "json",
      "role": "database",
      "downloadable": true,
