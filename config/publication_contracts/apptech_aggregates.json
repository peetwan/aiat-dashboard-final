      "max_identity_churn_ratio": 0.1,
      "max_count_drop_ratio": 0.1,
      "max_count_increase_ratio": 1,
      "completeness_rules": [{"pointer": "/household_economic_summary", "expected_count": 3}],
      "schema_policy": "stable"
    },
    {
      "path": "data/public/apptech_aggregates_manifest.json",
      "format": "json",
      "role": "provenance",
      "downloadable": false,
      "max_bytes": 1048576,
      "schema_policy": "stable"
    }
  ]
