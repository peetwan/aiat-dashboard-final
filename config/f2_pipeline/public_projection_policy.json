          "source_listing_identity",
          "supported_reviewed_merge",
          "unresolved_possible_duplicate"
        ],
        "population_basis": "All deduplicated map_inspiration subjects under original KPI_SCOPE, including people and cultural knowledge holders.",
        "provisional_identity_rule": "Preserve reviewed unresolved candidates as separate provisional identities; do not withhold detail or require a new identity decision solely for this status.",
        "publication_boundary": "Review individual field concerns separately from K12 membership. A person name is not a publication defect.",
        "required_record_fields": [
          "k12_eligible",
          "identity_status",
          "source_keys_json",
          "aliases_json"
        ],
        "withheld_subject_ids": {}
      },
      "source_context_review": {
        "rationale": "Original K12 scope includes all deduplicated map_inspiration subjects, including named people and cultural knowledge holders. Accepted separate provisional identities remain usable with explicit uncertainty. Public subject titles, attached listings, administrative geography and selected history/identity excerpts are projected without turning unrelated informant/contact fields into a directory.",
        "status": "measure_scoped_owner_field_approval",
        "unsafe_or_unsupported": [
          "account identifiers",
          "interviewee/contact passages",
          "unrelated informant and private contact directory fields",
          "coordinates",
          "addresses containing contacts",
          "funding, assessment and metrics blobs",
          "media rights or availability inference"
        ]
      },
      "source_id": "f2_culturalmap_university"
    },
