{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peetwan/aiat-dashboard-final/config/publication_contract.schema.json",
  "title": "AIAT reviewed publication contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "contract_id",
    "dataset_key",
    "source_scope",
    "source_ids",
    "builder",
    "grain_th",
    "identity",
    "geography",
    "as_of",
    "measures",
    "completeness",
    "privacy_profile",
    "outputs"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "dataset_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "source_scope": {
      "enum": ["approved_values", "catalog_metadata", "reference_geography"]
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "builder": {"type": "string", "minLength": 1},
    "grain_th": {"type": "string", "minLength": 1},
    "identity": {"type": "object", "minProperties": 1},
    "geography": {"type": "object", "minProperties": 1},
    "as_of": {"type": "object", "minProperties": 1},
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "denominator"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1}
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"const": "output_contracts"},
        "needs_review": {"type": "boolean"},
        "review_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "privacy_profile": {
      "enum": [
        "aggregate_public",
        "catalog_metadata",
        "provenance_metadata",
        "reference_geography"
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "role", "downloadable", "max_bytes", "schema_policy"],
      "oneOf": [
        {"required": ["path"], "not": {"required": ["path_glob"]}},
        {"required": ["path_glob"], "not": {"required": ["path"]}}
      ],
      "dependentRequired": {
        "records_pointer": ["identity_fields", "max_identity_churn_ratio"],
        "max_identity_churn_ratio": ["records_pointer"]
      },
      "properties": {
        "path": {"type": "string", "pattern": "^data/public/"},
        "path_glob": {"type": "string", "pattern": "^data/public/"},
        "expected_files": {"type": "integer", "minimum": 0},
        "format": {"enum": ["json", "geojson", "csv"]},
        "role": {"enum": ["database", "download", "provenance", "support"]},
        "downloadable": {"type": "boolean"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 26214400},
        "records_pointer": {"type": "string"},
        "identity_fields": {"type": "array", "items": {"type": "string"}},
        "expected_count": {"type": "integer", "minimum": 0},
        "minimum_count": {"type": "integer", "minimum": 0},
        "max_count_drop_ratio": {"type": "number", "minimum": 0, "maximum": 10},
        "max_count_increase_ratio": {"type": "number", "minimum": 0, "maximum": 10},
        "max_identity_churn_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "as_of_pointer": {"type": "string"},
        "headers": {"type": "array", "items": {"type": "string"}},
        "completeness_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/completeness_rule"}
        },
        "schema_policy": {"const": "stable"},
        "field_contexts": {
          "type": "object",
          "propertyNames": {"pattern": "^/"},
          "additionalProperties": {"enum": ["work_attribution", "organization", "public_contact", "public_location", "record_identifier", "public_measure"]}
        }
      }
    },
    "completeness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer"],
      "anyOf": [
        {"required": ["expected_count"]},
        {"required": ["minimum_count"]}
      ],
      "properties": {
        "pointer": {"type": "string", "pattern": "^(\\$|/.*)$"},
        "expected_count": {"type": "integer", "minimum": 0},
        "minimum_count": {"type": "integer", "minimum": 0},
        "max_count_drop_ratio": {"type": "number", "minimum": 0, "maximum": 10},
        "max_count_increase_ratio": {"type": "number", "minimum": 0, "maximum": 10}
      }
    }
  }
}
