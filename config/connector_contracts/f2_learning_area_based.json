    "participant rows และ aggregate rows ต้องอยู่คนละ dataset grain"
  ],
  "privacy": {
    "candidate_only": true,
    "contact_value_scan": true,
    "forbidden_public_fields": ["email", "phone", "address", "token", "password", "cookie", "authorization", "citizen", "national_id"]
  },
