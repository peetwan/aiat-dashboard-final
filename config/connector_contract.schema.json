{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peetwan/aiat-dashboard-final/config/connector_contract.schema.json",
  "title": "AIAT connector contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_id",
    "connector",
    "transport",
    "dataset_grains",
    "completeness_checks",
    "privacy",
    "sample_fixture"
  ],
  "properties": {
    "contract_version": {"const": "1.1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "connector": {"type": "string", "pattern": "^app\\.connectors\\.[a-z0-9_]+:[A-Za-z][A-Za-z0-9_]+$"},
    "transport": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "dataset_grains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_pattern", "grain_th", "identity_options", "geography_fields", "as_of_fields"],
        "properties": {
          "key_pattern": {"type": "string", "pattern": "^\\^.*\\$$"},
          "grain_th": {"type": "string", "minLength": 1},
          "identity_options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "geography_fields": {"type": "array", "items": {"type": "string"}},
          "as_of_fields": {"type": "array", "items": {"type": "string"}},
          "field_contexts": {
            "type": "object",
            "propertyNames": {"pattern": "^/"},
            "additionalProperties": {"enum": ["work_attribution", "organization", "public_contact", "public_location", "record_identifier", "public_measure"]}
          }
        }
      }
    },
    "completeness_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "contact_value_scan", "forbidden_public_fields"],
      "properties": {
        "candidate_only": {"const": true},
        "contact_value_scan": {"const": true},
        "forbidden_public_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "sample_fixture": {
      "type": "string",
      "pattern": "^tests/fixtures/connectors/[a-z0-9_]+\\.json$"
    },
    "notes_th": {"type": "string"}
  }
}
